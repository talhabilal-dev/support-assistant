# Keep the build context small and secrets out of the image.
.git
.gitignore
.github
.venv
.venv/
**/__pycache__
**/*.py[cod]
*.egg-info
build/
dist/

# Never bake in local secrets — production values come from the platform.
.env
.env.local
.env.*.local

# Frontend: keep the source (the web stage builds it) but not the heavy bits.
frontend/node_modules
frontend/dist
frontend/.vite

# Docs / agent config
.commandcode
AGENTS.md
CLAUDE.md
result.md
test.md

# NOTE: README.md is deliberately kept — pyproject.toml declares
#       `readme = "README.md"`, so uv needs it to build the project.

# NOTE: `static/` is deliberately NOT ignored — it is the fallback frontend
# when `frontend/` is unavailable, and the web stage reads it.
