# Server
NODE_ENV=development
PORT=3000
# Number of trusted proxy hops in front of the app (0 = none). Set to 1 behind a single LB.
TRUST_PROXY=0
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Rate limiting (sensitive auth endpoints only)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10

# Stricter limit for the OTP send endpoints
OTP_RATE_LIMIT_WINDOW_MS=900000
OTP_RATE_LIMIT_MAX=5

# Username availability polling (keyed per IP) — generous for typing
USERNAME_CHECK_RATE_LIMIT_WINDOW_MS=60000
USERNAME_CHECK_RATE_LIMIT_MAX=30

# Soft limit for the authenticated document endpoints (keyed per user)
DOCUMENT_RATE_LIMIT_WINDOW_MS=900000
DOCUMENT_RATE_LIMIT_MAX=100

# Anonymous assistant chat endpoint (keyed per IP)
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=30

# Anonymous ticket/escalation endpoint (keyed per IP)
TICKET_RATE_LIMIT_WINDOW_MS=900000
TICKET_RATE_LIMIT_MAX=5

# Soft limit for the authenticated owner reply endpoint (keyed per user)
TICKET_REPLY_RATE_LIMIT_WINDOW_MS=900000
TICKET_REPLY_RATE_LIMIT_MAX=50

# Assistant retrieval + CRAG-lite tuning
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATES=12
CRAG_MAX_REWRITES=0
CHAT_HISTORY_LIMIT=10
# Cap on output tokens for every model call (generation + gate)
ASSISTANT_MAX_OUTPUT_TOKENS=2000

# LangSmith tracing (set LANGSMITH_TRACING=true and add a key to enable)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=support-assistant

# Database
# TLS for Postgres connections: "true" for hosted providers (Neon/Supabase), "false" for local.
DATABASE_SSL=false
DATABASE_URL=postgres://postgres:dev@localhost:5432/support_assistant

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# HMAC secret used to sign anonymous chat visitor tokens
CHAT_TOKEN_SECRET=

# AI — OpenAI (chat, gate models and embeddings all share OPENAI_API_KEY)
OPENAI_API_KEY=
# Writes the final answer
CHAT_MODEL=gpt-4o-mini
# Fast model for the retention gate (rerank/grade/rewrite) — never writes the answer
PIPELINE_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Support Assistant <onboarding@resend.dev>"
