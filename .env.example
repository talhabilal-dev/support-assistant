# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Database ---
# PostgreSQL with the pgvector extension (the extension is created on startup).
DATABASE_URL=postgresql://dev:dev@localhost:5432/support_assistant
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# --- Models ---
OPENAI_API_KEY=sk-your-key
# OPENAI_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHAT_MODEL=gpt-4o-mini
CHAT_TEMPERATURE=0.0

# --- Ingestion ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_UPLOAD_BYTES=20971520

# --- Retrieval ---
RETRIEVAL_CANDIDATES=20
RETRIEVAL_TOP_K=8
RRF_K=60

# --- Future-proofing (leave disabled until the implementation is added) ---
ENABLE_RERANKER=false
# RERANKER_MODEL=
ENABLE_CRAG=false
CRAG_MAX_ITERATIONS=1

# --- Support tickets ---
ENABLE_TICKET_TOOL=true
TICKET_EMAIL_SUBJECT=We received your support request

# --- Email (Resend) ---
RESEND_API_KEY=re_your_key
EMAIL_FROM=Support Assistant <onboarding@resend.dev>
# EMAIL_REPLY_TO=

# --- Frontend ---
FRONTEND_DIST=static
